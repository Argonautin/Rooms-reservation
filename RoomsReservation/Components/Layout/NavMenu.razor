@using RoomsReservation.Data;

@inject AppState AppState

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">RoomsReservation</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Students">
                    <span class="bi" aria-hidden="true"></span> Students - sample
                </NavLink>
            </div>


            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Calendar">
                <span class="bi" aria-hidden="true"></span> Calendar
                </NavLink>
            </div>

                <div class="nav-item px-3">
                <NavLink class="nav-link" href="reservation">
                        <span class="bi" aria-hidden="true"></span> Rezerwacja
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/dodaj_sale">
                        <span class="bi" aria-hidden="true"></span> Dodajsale
                    </NavLink>
                </div>

                @if (AppState.CurrentUser?.IsProfessor == true)
                {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="reports">
                        <span class="bi" aria-hidden="true"></span> Eksport Raportu
                    </NavLink>
                </div>
                }

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="building">
                        <span class="bi" aria-hidden="true"></span> Plan budynku - edycja
                    </NavLink>
                </div>
    </nav>
</div>

@code {

//@if(AppState.CurrentUser != null) @if(AppState.CurrentUser.isProfessor) 
//to jest jak na koniec by Student widział tylko kalendarz a profesor reszte
//i dodać to trzeba między divami
        
    protected override void OnInitialized()
    {
        AppState.OnChange += () => InvokeAsync(StateHasChanged);
    }
}