@using RoomsReservation.Data

@page "/reports"

@* @inject AppDbContext Db
@inject AppState AppState

<h3>Reports</h3>

<h2>Raport wykorzystania sal – @AppState.CurrentUser.FirstName @AppState.CurrentUser.LastName</h2>

<ul>
	<li>Łączna liczba rezerwacji: @UserReservationsCount</li>
	<li>Najczęściej rezerwowana sala: @UserMostUsedRoom</li>
	<li>Ostatnia rezerwacja: @LastReservationInfo</li>
</ul>

<button class="btn" @onclick="ExportUserCsv">Eksport CSV (użytkownik)</button>
<button class="btn" @onclick="ExportUserPdf">Eksport PDF (użytkownik)</button>

<hr />

<h2>Statystyki ogólne</h2>

<ul>
	<li>Łączna liczba rezerwacji: @TotalReservations</li>
	<li>Najczęściej używana sala: @MostUsedRoom</li>
	<li>Najbardziej aktywny użytkownik: @MostActiveUser</li>
</ul>

<button class="btn" @onclick="ExportGlobalCsv">Eksport CSV (globalny)</button>
<button class="btn" @onclick="ExportGlobalPdf">Eksport PDF (globalny)</button>

@code {
	private int UserReservationsCount;
	private string UserMostUsedRoom = "";
	private string LastReservationInfo = "";

	private int TotalReservations;
	private string MostUsedRoom = "";
	private string MostActiveUser = "";

	protected override void OnInitialized()
	{
		LoadGlobalStats();
		LoadUserStats();
	}

	private void LoadUserStats()
	{
		if (AppState.CurrentUser == null)
			return;

		var userId = AppState.CurrentUser.Id;

		var reservations = Db.Reservations
			.Where(r => r.UserId == userId)
			.ToList();

		UserReservationsCount = reservations.Count;

		UserMostUsedRoom = reservations
			.GroupBy(r => r.RoomId)
			.OrderByDescending(g => g.Count())
			.Select(g => $"Sala {g.Key} ({g.Count()} rezerwacji)")
			.FirstOrDefault() ?? "Brak danych";

		LastReservationInfo = reservations
			.OrderByDescending(r => r.Date)
			.Select(r => $"{r.Date:dd.MM.yyyy} – sala {r.RoomId}")
			.FirstOrDefault() ?? "Brak rezerwacji";
	}

	private void LoadGlobalStats()
	{
		var reservations = Db.Reservations.ToList();

		TotalReservations = reservations.Count;

		MostUsedRoom = reservations
			.GroupBy(r => r.RoomId)
			.OrderByDescending(g => g.Count())
			.Select(g => $"Sala {g.Key} ({g.Count()} rezerwacji)")
			.FirstOrDefault() ?? "Brak danych";

		MostActiveUser = reservations
			.GroupBy(r => r.UserId)
			.OrderByDescending(g => g.Count())
			.Select(g => $"Użytkownik {g.Key} ({g.Count()} rezerwacji)")
			.FirstOrDefault() ?? "Brak danych";
	}

	private void ExportUserCsv()
	{
		//Message = "Wygenerowano CSV dla użytkownika (tu dodasz logikę eksportu).";
	}

	private void ExportUserPdf()
	{
		//Message = "Wygenerowano PDF dla użytkownika (tu dodasz logikę eksportu).";
	}

	private void ExportGlobalCsv()
	{
		//Message = "Wygenerowano globalny CSV (tu dodasz logikę eksportu).";
	}

	private void ExportGlobalPdf()
	{
		//Message = "Wygenerowano globalny PDF (tu dodasz logikę eksportu).";
	}
} *@
