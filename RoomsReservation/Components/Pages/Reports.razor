@page "/reports"
@using RoomsReservation.Data
@using RoomsReservation.Data.Tables
@using Microsoft.EntityFrameworkCore;

@inject NavigationManager Nav
@inject AppDbContext Db
@inject AppState AppState
@inject IJSRuntime JS

<div id="report-content">
	<div>
		<p><h2>Twoje Statystyki:</h2></p>
		<h3>
			Łączna liczba twoich rezerwacji: @ReservationCount
		</h3>
		<h3>
			Łączna liczba zarezerwowanych zarezerwowanych twoich: @TotalHours
		</h3>

		<h3>
			Twoja najczęściej rezerwowana sala: @MostReservedRoom
		</h3>
	</div><br><br><br><br>

	<div>
		<p><h2>Statystyki ogólne:</h2></p>
		<h3>
			Łączna liczba  rezerwacji: @GlobalReservationCount
		</h3>
		<h3>
			Łączna liczba godzin zarezerwowanych: @GlobalTotalHours
		</h3>

		<h3>
			Najczęściej rezerwowana sala: @GlobalMostReservedRoom
		</h3>
	</div>
</div><br><br>

<button class="save-btn" @onclick="PDFExport">Exportuj do PDF</button>

@code {
	List<Reservation> UserReservations = new List<Reservation>();
	List<Reservation> GlobalReservations = new List<Reservation>();

	public int ReservationCount => UserReservations.Count;
	public double TotalHours => UserReservations.Count * 1.5;
	public string MostReservedRoom => UserReservations.GroupBy(r => r.Room).OrderByDescending(g => g.Count()).Select(g => g.Key.RoomName).FirstOrDefault() ?? "Brak danych";

	public int GlobalReservationCount => GlobalReservations.Count;
	public double GlobalTotalHours => GlobalReservations.Count * 1.5;
	public string GlobalMostReservedRoom => GlobalReservations.GroupBy(r => r.Room).OrderByDescending(g => g.Count()).Select(g => g.Key.RoomName).FirstOrDefault() ?? "Brak danych";


	protected override async Task OnInitializedAsync()
	{
		if (AppState.CurrentUser == null)
		{
			Nav.NavigateTo("/reservation");
			return;
		}

		UserReservations = Db.Reservations.Include(r => r.Time_Reservation).Include(r => r.Room).Where(r => r.UserId == AppState.CurrentUser.Id).ToList();
		GlobalReservations = Db.Reservations.Include(r => r.Time_Reservation).Include(r => r.Room).ToList();
	}

	public async Task PDFExport()
	{
		await JS.InvokeVoidAsync("downloadPdf");
	}
}
