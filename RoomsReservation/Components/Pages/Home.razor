@using Microsoft.AspNetCore.Identity;
@using RoomsReservation.Data;
@using RoomsReservation.Data.Tables;
@using RoomsReservation.Services;
@using RoomsReservation.Services.RoleClassifier

@page "/"
@rendermode InteractiveServer
@inject AppDbContext Db
@inject AppState AppState
@inject IEmailService EmailService
@inject RoleClassifierClient RoleClassifier

<PageTitle>Strona główna</PageTitle>

<h1>Zaloguj się lub zarejestruj</h1>

<ul>
    @foreach (var s in Users)
    {
        <li class="uzytkownicy">
            @s.FirstName @s.LastName
            @(s.IsProfessor ? "Professor" : "Student")
            @s.Email
        </li>
    }
</ul>

@if (AppState.CurrentUser != null)
{
    <h1>
        Zalogowano jako:
        @AppState.CurrentUser.FirstName @AppState.CurrentUser.LastName
        (@(AppState.CurrentUser.IsProfessor ? "Profesor" : "Student"))
    </h1>
}

@if(AppState.CurrentUser == null)
{
    <button class="login-btn" @onclick="ShowLogin">Zaloguj się</button>
}
else
{
    <button class="login-btn" @onclick="AppState.Logout">Wyloguj się</button>
}

<div class="auth-modal @(ActiveForm == "register" ? "show slide" : (ActiveForm == "login" ? "show" : ""))">
    <button class="close-btn-modal" @onclick="CloseModal">
        <i class='bx bxs-x'></i>
    </button>

    <div class="form-box login">
        <h2>Logowanie</h2>

        <div class="input-box">
            <input @bind="LoginEmail" placeholder="Email">
            <i class='bx bxs-envelope'></i>
        </div>

        <div class="input-box">
            <input type="password" @bind="LoginPassword" placeholder="Hasło">
            <i class='bx bxs-lock'></i>
        </div>

        <button class="btn" @onclick="Login">Zaloguj się</button>

        <p>
            Nie masz konta?
            <a href="#" @onclick="ShowRegister">Zarejestruj się</a>
        </p>

        @if (!string.IsNullOrEmpty(LoginMessage))
        {
            <p class="error">@LoginMessage</p>
        }
    </div>

    <div class="form-box register">
        <h2>Rejestracja</h2>

        <div class="input-box">
            <input @bind="RegisterFirstName" placeholder="Imię">
            <i class='bx bxs-user'></i>
        </div>

        <div class="input-box">
            <input @bind="RegisterLastName" placeholder="Nazwisko">
            <i class='bx bxs-user'></i>
        </div>

        <div class="input-box">
            <input @bind="RegisterEmail" placeholder="Email">
            <i class='bx bxs-envelope'></i>
        </div>

        <div class="input-box">
            <input type="password" @bind="RegisterPassword" placeholder="Hasło">
            <i class='bx bxs-lock'></i>
        </div>

        <p class="role-info">
            Rola konta zostanie automatycznie określona na podstawie adresu e-mail.
        </p>

        <button class="btn" @onclick="Register">Zarejestruj się</button>

        <p>
            Masz już konto?
            <a href="#" @onclick="ShowLogin">Zaloguj się</a>
        </p>

        @if (!string.IsNullOrEmpty(RegisterMessage))
        {
            <p class="error">@RegisterMessage</p>
        }
    </div>
</div>

@code 
{
    private List<User> Users = new();

    private string ActiveForm = "";

    private string LoginEmail = "";
    private string LoginPassword = "";
    private string LoginMessage = "";

    private string RegisterFirstName = "";
    private string RegisterLastName = "";
    private string RegisterEmail = "";
    private string RegisterPassword = "";
    private PasswordHasher<User> hasher = new();
    private string RegisterMessage = "";

    protected override void OnInitialized()
    {
        Users = Db.Users.ToList();
    }

    private void ShowLogin() => ActiveForm = "login";
    private void ShowRegister() => ActiveForm = "register";
    private void CloseModal() => ActiveForm = "";

    private async Task Login()
    {
        var user = Db.Users.FirstOrDefault(u => u.Email == LoginEmail);
        if (user == null)
        {
            LoginMessage = "Nie znaleziono użytkownika";
            return;
        }

        var result = hasher.VerifyHashedPassword(user, user.Password, LoginPassword);

        if (result != PasswordVerificationResult.Success)
        {
            LoginMessage = "Niepoprawne hasło.";
            return;
        }

        AppState.SetUser(user);

        LoginMessage = $"Witaj {user.FirstName}!";
        CloseModal();
    }
    private async Task Register()
    {
        RegisterMessage = "";

        if (string.IsNullOrWhiteSpace(RegisterFirstName) ||
            string.IsNullOrWhiteSpace(RegisterLastName) ||
            string.IsNullOrWhiteSpace(RegisterEmail) ||
            string.IsNullOrWhiteSpace(RegisterPassword))
        {
            RegisterMessage = "Wszystkie pola są wymagane.";
            return;
        }

        var normalizedEmail = RegisterEmail.Trim().ToLowerInvariant();

        if (Db.Users.Any(u => u.Email.ToLower() == normalizedEmail))
        {
            RegisterMessage = "Konto z takim adresem e-mail już istnieje.";
            return;
        }

        try
        {
            var classification = await RoleClassifier.ClassifyAsync(
                new RoleClassificationRequest
                {
                    FirstName = RegisterFirstName.Trim(),
                    LastName = RegisterLastName.Trim(),
                    Email = normalizedEmail
                });

            if (classification is null)
            {
                RegisterMessage =
                    "Usługa klasyfikacji nie zwróciła odpowiedzi. Spróbuj ponownie.";
                return;
            }


            if (!classification.Allowed)
            {
                RegisterMessage = string.IsNullOrWhiteSpace(classification.Reason)
                    ? "Rejestracja jest dostępna wyłącznie dla adresów e-mail SAN."
                    : classification.Reason;

                return;
            }

            var isProfessor = string.Equals(
                classification.Role,
                "professor",
                StringComparison.OrdinalIgnoreCase);

            var isStudent = string.Equals(
                classification.Role,
                "student",
                StringComparison.OrdinalIgnoreCase);

            if (!isProfessor && !isStudent)
            {
                RegisterMessage =
                    "Usługa klasyfikacji zwróciła nieprawidłową rolę użytkownika.";
                return;
            }

            var newUser = new User
            {
                FirstName = RegisterFirstName.Trim(),
                LastName = RegisterLastName.Trim(),
                Email = normalizedEmail,
                IsStudent = isStudent,
                IsProfessor = isProfessor
            };

            newUser.Password = hasher.HashPassword(newUser, RegisterPassword);

            Db.Users.Add(newUser);
            await Db.SaveChangesAsync();

            Users = Db.Users.ToList();

            RegisterMessage = isProfessor
                ? "Konto utworzone. Mikroserwis przypisał rolę: Wykładowca."
                : "Konto utworzone. Mikroserwis przypisał rolę: Student.";

            ShowLogin();
        }
        catch (HttpRequestException)
        {
            RegisterMessage =
                "Nie można połączyć się z mikroserwisem klasyfikacji. " +
                "Uruchom mikroserwis Clojure na porcie 8081.";
        }
        catch (Exception)
        {
            RegisterMessage =
                "Podczas tworzenia konta wystąpił nieoczekiwany błąd.";
        }
    }
   
}