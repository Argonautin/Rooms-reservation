@page "/reservation" 
@using Microsoft.EntityFrameworkCore
@using RoomsReservation.Data.Tables
@using RoomsReservation.Data

@inject NavigationManager Nav
@inject AppDbContext Db
@inject AppState AppState

<div class="layout">
	<div class="left-panel">
		<div class="floor-selector">
			@foreach (var floor in Floors)
			{
				<button class="floor-btn"
						@onclick="() => SelectedFloor = floor">
					@floor
				</button>
			}

			<button class="your-Reservation-btn" 
				@onclick="@(() => Nav.NavigateTo("/YourReservation"))">
				Twoje Rezerwacje
			</button>
		</div>

		<div>
			
		</div>

		@if (SelectedFloor != null)
		{
			<FloorPlan FloorName="@SelectedFloor"
					   Rooms="@FloorsData[SelectedFloor]"
					   OnRoomSelected="RoomClicked" />
		}

	</div>

	<div class="right-panel">
		@if (SelectedRoom != null)
		{
			<h3>@SelectedRoom.RoomName</h3>
			<h4>@SelectedDate.ToString("dd.MM.yyyy")</h4>

			<label>Wybierz godzine</label>

			<p>
				@foreach (var time in TimesList)
				{
					<button class="slot-button
						@(BusyTimeIds.Contains(time.Id) ? "disable" : "")
						@(SelectedTimeId == time.Id ? "active" : "")"
							@onclick="() => SelectedTimeId = time.Id">
						@time.StartTime.ToString(@"hh\:mm") - @time.EndTime.ToString(@"hh\:mm")
					</button>
				}
			</p>

			
			<button class="save-btn" @onclick="SaveReservation">Zarezerwuj</button>
		}
	</div>
</div>

@code {
	public DateOnly SelectedDate;
	public HashSet<int> BusyTimeIds = new();

	List<string> Floors = new();

	private string newEquipment = string.Empty;
	string? SelectedFloor;

	Room? SelectedRoom;

	Dictionary<string, List<Room>> FloorsData = new();
	List<Time_Reservation> TimesList = new();

	int SelectedTimeId;

	//Inicjalizacja danych
	protected override async Task OnInitializedAsync()
	{
		SelectedDate = AppState.SelectedDate ?? DateOnly.FromDateTime(DateTime.Today);
		SelectedRoom = AppState.SelectedRoom;

		var rooms = await Db.Rooms.ToListAsync();
		var times = await Db.Time_Reservation.ToListAsync();

		Floors = await Db.Rooms.Select(r => r.Floor).Distinct().OrderBy(f => f).Select(f => $"Piętro {f}").ToListAsync();

		FloorsData = GroupRoomsByFloor(rooms);

		TimesList = times
			.OrderBy(t => t.StartTime)
			.ToList();

		SelectedFloor = Floors.First();

	}

	//Pozyskanie danych z Bazy danych o pokoju, który został kliknięty
	async Task RoomClicked(Room room)
	{
		if (room.RoomName is "WC1" or "WC2" or "Winda" or "Schody" or "Korytarz")
			return;

		SelectedRoom = await Db.Rooms.FirstAsync(r => r.Id == room.Id);

		// pobieranie z bazy danych zajętych terminów dla wybranego pokoju i daty
		BusyTimeIds = await Db.Reservations.Where(r =>
			r.RoomId == SelectedRoom.Id &&
			r.DateReservation == SelectedDate)
			.Select(r => r.Time_ReservationId).ToHashSetAsync();
	}

	//grupowanie pokoi względem pięter
	private Dictionary<string, List<Room>> GroupRoomsByFloor(List<Room> rooms)
	{
		return rooms.GroupBy(r => r.Floor).ToDictionary
		(
			g => $"Piętro {g.Key}",
			g => g.ToList()
		);
	}

	private async Task SaveReservation()
	{
		if (SelectedRoom == null || SelectedTimeId == 0)
			return;

		var user = AppState.CurrentUser;

		if (user == null) return;

		var reservation = new Reservation
		{
			UserId = user.Id,
			RoomId = SelectedRoom.Id,
			Time_ReservationId = SelectedTimeId,
			DateReservation = SelectedDate
		};

		Db.Reservations.Add(reservation);

		await Db.SaveChangesAsync();
	}
}
