@page "/reservation"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using RoomsReservation.Data.Tables
@using RoomsReservation.Data

@inject AppDbContext Db
@inject AppState AppState

<div class="layout">

	<div class="left-panel">
		<div class="floor-selector">
			@foreach (var floor in Floors)
			{
				<button class="floor-btn"
						@onclick="() => SelectedFloor = floor">
					@floor
				</button>
			}
		</div>

		@if (SelectedFloor != null)
		{
			<FloorPlan FloorName="@SelectedFloor"
					   Rooms="@FloorsData[SelectedFloor]"
					   OnRoomSelected="RoomClicked" />
		}

	</div>

	<div class="right-panel">
		@if (SelectedRoom != null)
		{
			<h3>@SelectedRoom.RoomName</h3>

			<label>Wybierz godzine</label>


			<InputRadioGroup @bind-Value="SelectedRoom.TimeSlot">
				<ul>
					<li>
						<InputRadio Value="1" /> 8:00 - 9:30
					</li>
					<li>
						<InputRadio Value="2" /> 9:45 - 11:15
					</li>
					<li>
						<InputRadio Value="3" /> 11:30 - 13:00
					</li>
					<li>
						<InputRadio Value="4" /> 13:30 - 15:00
					</li>
					<li>
						<InputRadio Value="5" /> 15:15-16:45
					</li>
					<li>
						<InputRadio Value="6" /> 17:00 - 18:30
					</li>
					<li>
						<InputRadio Value="7" /> 18:45 - 20:15
					</li>
				</ul>
			</InputRadioGroup>


			<button class="save-btn" @onclick="SaveReservation">Zapisz</button>
		}
	</div>
</div>

@code {

	List<string> Floors = new();

	private string newEquipment = string.Empty;
	public int TimeSlot { get; set; }
	string? SelectedFloor;


	Room? SelectedRoom;
	Dictionary<string, List<Room>> FloorsData = new();

	//Inicjalizacja danych o pokojach i piętrach
	protected override async Task OnInitializedAsync()
	{
		var rooms = await Db.Rooms.ToListAsync();

		Floors = await Db.Rooms.Select(r => r.Floor).Distinct().OrderBy(f => f).Select(f => $"Piętro {f}").ToListAsync();
		FloorsData = GroupRoomsByFloor(rooms);

		SelectedFloor = Floors.First();
	}

	//Pozyskanie danych z Bazy danych o pokoju, który został kliknięty
	async Task RoomClicked(Room room)
	{
		if (room.RoomName is "WC1" or "WC2" or "Winda" or "Schody" or "Korytarz")
			return;

		SelectedRoom = await Db.Rooms.FirstAsync(r => r.Id == room.Id);
	}

	//grupowanie pokoi względem pięter
	private Dictionary<string, List<Room>> GroupRoomsByFloor(List<Room> rooms)
	{
		return rooms.GroupBy(r => r.Floor).ToDictionary
		(
			g => $"Piętro {g.Key}",
			g => g.ToList()
		);
	}

	private async Task SaveReservation()
	{
		if (SelectedRoom != null)
		{
			var user = AppState.CurrentUser;

			if (user != null && SelectedRoom.TimeSlot > 0)
			{
				var (start, end) = GetTimeRange(SelectedRoom.TimeSlot);

				var reservation = new Reservation
					{
						UserId = user.Id,
						RoomId = SelectedRoom.Id,
						Start = start,
						End = end
					};

				Db.Reservations.Add(reservation);

				var roomInDb = await Db.Rooms.FirstAsync(r => r.Id == SelectedRoom.Id);
				roomInDb.Status = false;

				await Db.SaveChangesAsync();
			}
		}
	}

	private (DateTime start, DateTime end) GetTimeRange(int slot)
	{
		return slot switch
		{
			1 => (DateTime.Today.AddHours(8), DateTime.Today.AddHours(9.5)),
			2 => (DateTime.Today.AddHours(9.75), DateTime.Today.AddHours(11.25)),
			3 => (DateTime.Today.AddHours(11.5), DateTime.Today.AddHours(13)),
			4 => (DateTime.Today.AddHours(13.5), DateTime.Today.AddHours(15)),
			5 => (DateTime.Today.AddHours(15.25), DateTime.Today.AddHours(16.75)),
			6 => (DateTime.Today.AddHours(17), DateTime.Today.AddHours(18.5)),
			7 => (DateTime.Today.AddHours(18.75), DateTime.Today.AddHours(20.25)),
			_ => throw new Exception("Niepoprawny slot")
		};
	}
}
