@page "/building"
@using Microsoft.EntityFrameworkCore
@using RoomsReservation.Data.Tables
@using RoomsReservation.Data

@inject AppDbContext Db

<div class="layout">

    <div class="left-panel">
        <div class="floor-selector">
            @foreach (var floor in Floors)
            {
                <button class="floor-btn"
                        @onclick="() => SelectedFloor = floor">
                    @floor
                </button>
            }
        </div>

        @if (SelectedFloor != null)
        {
            <FloorPlan FloorName="@SelectedFloor"
                       Rooms="@FloorsData[SelectedFloor]"
                       OnRoomSelected="RoomClicked" />
        }

    </div>

    <div class="right-panel">
        @if (SelectedRoom != null)
        {
            <h3>@SelectedRoom.RoomName</h3>

            <label>Opis:</label>
            <textarea @bind="SelectedRoom.Description"></textarea>

            <label>Pojemność:</label>
            <input type="number" @bind="SelectedRoom.Capacity" />

            
            <p>
                Wybierz wyposażenie:
                <select @bind="newEquipment" style="width: 200px"> <-- trzeba zrobić to w css --/>
                    @foreach (var eq in AvalaibleEquipment)
                    {
                        <option value="@eq.EquipmentName">@eq.EquipmentName</option>
                    }
                </select>
                <button class="save-btn" @onclick="AddEquipment">Dodaj</button>
            </p>


            <p>Bieżące wyposażenie sali:</p>
            <p>
                <ul>
                    @foreach (var re in SelectedRoom.RoomEquipments)
                    {
                        <li>
                            @re.Equipment.EquipmentName <button class="save-btn" @onclick="() => RemoveEquipment(re)">Usuń</button>
                        </li>
                    }
                </ul>
            </p>

            

            <p>
                <button class="save-btn" @onclick="SaveRoom">Zapisz</button>
            </p>

        }
        else
        {
            <p>Kliknij pokój, aby zobaczyć szczegóły.</p>
        }
    </div>

</div>

@code {
    private string newEquipment = string.Empty;
    string? SelectedFloor;

    Room? SelectedRoom;
    Dictionary<string, List<Room>> FloorsData = new();
    List<Equipments> AvalaibleEquipment = new();
    List<string> Floors = new();

    protected override async Task OnInitializedAsync()
    {
        var rooms = await Db.Rooms.ToListAsync();

        Floors = await Db.Rooms.Select(r => r.Floor).Distinct().OrderBy(f => f).Select(f => $"Piętro {f}").ToListAsync();

        FloorsData = GroupRoomsByFloor(rooms);
        AvalaibleEquipment = await Db.Equipments.ToListAsync();

        SelectedFloor = Floors.First();
    }

    async Task RoomClicked(Room room)
    {
        if (room.RoomName is "WC1" or "WC2" or "Winda" or "Schody" or "Korytarz")
            return;

        SelectedRoom = await Db.Rooms.Include(r => r.RoomEquipments).ThenInclude(re => re.Equipment).FirstAsync(r => r.Id == room.Id);
    }

    public void AddEquipment()
    {
        var newRoomEquipment = new RoomEquipment
        {
            RoomId = SelectedRoom!.Id,
            EquipmentId = AvalaibleEquipment.FirstOrDefault(eq => eq.EquipmentName == newEquipment)?.Id ?? 0
        };

        Db.RoomEquipments.Add(newRoomEquipment);
    }

    public async Task RemoveEquipment(RoomEquipment roomEquipment)
    {
        Db.RoomEquipments.Remove(roomEquipment);
        await Db.SaveChangesAsync();
    }

    async Task SaveRoom()
    {
        Db.Rooms.Update(SelectedRoom!);

        await Db.SaveChangesAsync();
    }

    private Dictionary<string, List<Room>> GroupRoomsByFloor(List<Room> rooms)
    {
        return rooms.GroupBy(r => r.Floor).ToDictionary
        (
            g => $"Piętro {g.Key}",
            g => g.ToList()
        );
    }
}