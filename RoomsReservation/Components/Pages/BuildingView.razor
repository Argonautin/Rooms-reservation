@page "/building"
@using Microsoft.EntityFrameworkCore
@using RoomsReservation.Data.Tables
@using RoomsReservation.Data

@inject AppDbContext Db

<div class="layout">

    <div class="left-panel">
        <div class="floor-selector">
            @foreach (var floor in Floors)
            {
                <button class="floor-btn"
                        @onclick="() => SelectedFloor = floor">
                    @floor
                </button>
            }
        </div>

        @if (SelectedFloor != null)
        {
            <FloorPlan FloorName="@SelectedFloor"
                       Rooms="@FloorsData[SelectedFloor]"
                       OnRoomSelected="RoomClicked" />
        }

    </div>

    <div class="right-panel">
        @if (SelectedRoom != null)
        {
            <h3>@SelectedRoom.RoomName</h3>

            <label>Opis:</label>
            <textarea @bind="SelectedRoom.Description"></textarea>

            <label>Pojemność:</label>
            <input type="number" @bind="SelectedRoom.Capacity" />

            <label>Profesor:</label>
            <input @bind="SelectedRoom.Professor" />

            <label>Elementy Wyposarzenia:</label>
            <ul>
                <input type="checkbox" @bind="SelectedRoom.Status" />
            </ul>


            <button class="save-btn" @onclick="SaveRoom">Zapisz</button>
        }
        else
        {
            <p>Kliknij pokój, aby zobaczyć szczegóły.</p>
        }
    </div>

</div>

@code {
    List<string> Floors = new();

    string ?SelectedFloor;

    Room? SelectedRoom;

    Dictionary<string, List<Room>> FloorsData = new();

    protected override async Task OnInitializedAsync()
    {
        var rooms = await Db.Rooms.ToListAsync();

        Floors = await LoadFloorsAsync();
        FloorsData = GroupRoomsByFloor(rooms);

        SelectedFloor = Floors.First();
    }

    void RoomClicked(Room room)
    {
        if (room.RoomName is "WC1" or "WC2" or "Winda" or "Schody" or "Korytarz")
            return;

        SelectedRoom = room;
    }

    async Task SaveRoom()
    {
        Db.Rooms.Update(SelectedRoom!);
        await Db.SaveChangesAsync();
    }

    private async Task<List<string>> LoadFloorsAsync()
    {
        return await Db.Rooms
            .Select(r => r.Floor)
            .Distinct()
            .OrderBy(f => f)
            .Select(f => $"Piętro {f}")
            .ToListAsync();
    }

    private Dictionary<string, List<Room>> GroupRoomsByFloor(List<Room> rooms)
    {
        return rooms.GroupBy(r => r.Floor).ToDictionary
        (
            g => $"Piętro {g.Key}",
            g => g.ToList()
        );
    }
}