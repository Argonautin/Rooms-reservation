@page "/Calendar"
@using Microsoft.EntityFrameworkCore
@using RoomsReservation.Data
@using RoomsReservation.Data.Tables
@inject AppDbContext Db
@inject NavigationManager Nav
@inject AppState AppState

<PageTitle>Kalendarz sal</PageTitle>

<div class="calendar-page">
    <section class="calendar-header-card">
        <div>
            <p class="eyebrow"></p>
            <h1>Kalendarz sal</h1>
        </div>
    </section>

    <section class="calendar-layout">

        <article class="calendar-card">
            <div class="filters-panel">
                <h3>Wyszukiwanie dostępnych sal</h3>

                <div class="filter-grid">
                    <div>
                        <label>Data</label>
                        <input type="date" @bind="filterDate" @bind:format="yyyy-MM-dd" />
                    </div>

                    <div>
                        <label>Piętro</label>
                        <input type="number" @bind="filterFloor" />
                    </div>

                    <div>
                        <label>Minimalna pojemność</label>
                        <input type="number" @bind="filterCapacity" />
                    </div>

                    <div>
                        <label>Wyposażenie</label>
                        <select @bind="filterEquipment" style="width: 200px">
                            <-- trzeba zrobić to w css -- />
                            <option value=""></option>
                            @foreach (var eq in AvalaibleEquipment)
                            {
                                <option value="@eq.EquipmentName">@eq.EquipmentName</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="filter-actions">
                    <button type="button" class="nextPage-btn" @onclick="ApplyFilters">Szukaj</button>
                    <button type="button" class="nextPage-btn" @onclick="ResetFilters">Wyczyść</button>
                </div>
            </div>

            <div class="calendar-toolbar">
                <button type="button" class="nav-btn" aria-label="Poprzedni miesiąc" @onclick="PreviousMonth">←</button>
                <div class="month-label">@MonthTitle</div>
                <button type="button" class="nav-btn" aria-label="Następny miesiąc" @onclick="NextMonth">→</button>
            </div>
            <div class="weekdays">
                @foreach (var dayName in DayNames)
                {
                    <div class="weekday">@dayName</div>
                }
            </div>

            <div class="month-grid">
                @foreach (var cell in CalendarDays)
                {
                    <button type="button"
                            class="day-cell @(cell.IsCurrentMonth ? "" : "muted")  @(SelectedDate == cell.Date ? "selected" : "")"
                            @onclick="() => SelectDate(cell.Date)">
                        <div class="day-top">
                            <span class="day-number">@cell.Date.Day</span>
                        </div>

                        <div class="day-body"></div>
                    </button>
                }
            </div>
        </article>

        <aside class="details-card">

            <div class="details-header">
                <h2>@SelectedDate.ToString("dd.MM.yyyy")</h2>
            </div>

            @if (rooms.Count == 0)
            {
                <div class="empty-state">
                    <p>Brak sal w bazie danych.</p>
                </div>
            }
            else
            {
                <div class="event-list">
                    @foreach (var room in FilteredRooms)
                    {
                        <div type="button" class="event-card @(SelectedRoom == room ? "selected" : "")"
                             @onclick="() => SelectRoom(room)">
                            <div class="event-time">
                                <strong>@room.RoomName</strong>
                                <p><span>Piętro @room.Floor</span></p>
                                <div class="btn-to-reservation @(isRoomClicked() && SelectedRoom == room ? "active" : "")">
                                    <button type="button" class="badge bg-success" @onclick="GoToReservation">
                                        Zarezerwuj
                                    </button>
                                </div>
                            </div>
                            <div class="event-content">
                                <p>Pojemność: @room.Capacity</p>
                                @if (!string.IsNullOrWhiteSpace(room.Description))
                                {
                                    <div class="room-description">Opis: @room.Description</div>
                                }
                                <p>Wyposażenie: @string.Join(", ", room.RoomEquipments.Select(re => re.Equipment.EquipmentName))</p>
                            </div>
                        </div>
                    }
                </div>
            }

        </aside>
    </section>
</div>

@code {
    [Parameter][SupplyParameterFromQuery] public int? roomId { get; set; }

    private Room? SelectedRoom;
    private List<Room> rooms = new();
    private List<Room> FilteredRooms = new();
    private List<Reservation> reservations = new();
    private List<CalendarDayCell> CalendarDays = new();
    private List<Equipments> AvalaibleEquipment = new();

    private DateTime currentMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime SelectedDate = DateTime.Today;

    DateTime filterDate { get; set; } = DateTime.Today;
    TimeOnly filterStartTime { get; set; }
    TimeOnly filterEndTime { get; set; }
    private int? filterFloor;
    private int? filterCapacity;
    private string? filterEquipment;

    private static readonly string[] DayNames = ["Pon", "Wt", "Śr", "Czw", "Pt", "Sob", "Nd"];
    private string MonthTitle => currentMonth.ToString("MMMM yyyy", new System.Globalization.CultureInfo("pl-PL"));



    protected override async Task OnParametersSetAsync()
    {
        await LoadDataAsync(roomId);
    }

    private async Task LoadDataAsync(int? roomId)
    {
        await LoadCalendarAsync();

        BuildCalendar();

        if (SelectedDate.Month != currentMonth.Month || SelectedDate.Year != currentMonth.Year)
            SelectedDate = currentMonth;
    }


    private async Task LoadCalendarAsync()
    {

        rooms = await Db.Rooms
            .Include(r => r.RoomEquipments)
                .ThenInclude(re => re.Equipment)
            .AsNoTracking()
            .OrderBy(r => r.RoomName)
            .ToListAsync();

        AvalaibleEquipment = await Db.Equipments.ToListAsync();

        FilteredRooms = rooms;
    }

    private async Task ApplyFilters()
    {
        await SelectDate(filterDate);

        var query = rooms.AsEnumerable();

        if (filterFloor != null)
        {
            query = query.Where(r => r.Floor == filterFloor);
        }

        if (filterCapacity != null)
        {
            query = query.Where(r => r.Capacity >= filterCapacity.Value);
        }

        if (filterEquipment != null)
        {
            query = query.Where(r => r.RoomEquipments.Any(re => re.Equipment.EquipmentName == filterEquipment));
        }

        FilteredRooms = query.ToList();

        StateHasChanged();
    }

    private void ResetFilters()
    {
        SelectedDate = DateTime.Today;
        FilteredRooms = rooms;
        
        filterFloor = null;
        filterCapacity = null;
        filterEquipment = null;

        StateHasChanged();
    }

    private void BuildCalendar()
    {
        CalendarDays.Clear();

        var firstDay = new DateTime(currentMonth.Year, currentMonth.Month, 1);
        var offset = ((int)firstDay.DayOfWeek + 6) % 7;
        var startDate = firstDay.AddDays(-offset);

        for (int i = 0; i < 42; i++)
        {
            var date = startDate.AddDays(i);
            CalendarDays.Add(new CalendarDayCell
            {
                Date = date,
                IsCurrentMonth = date.Month == currentMonth.Month
            });
        }
    }

    private async Task PreviousMonth()
    {
        currentMonth = currentMonth.AddMonths(-1);
        await LoadCalendarAsync();
    }

    private async Task NextMonth()
    {
        currentMonth = currentMonth.AddMonths(1);
        await LoadCalendarAsync();
    }

    private async Task SelectDate(DateTime date)
    {
        SelectedDate = date;

        DateOnly SelectedDateOnly = DateOnly.FromDateTime(date);

        SelectedRoom = null;
    }

    private void SelectRoom(Room room)
    {
        SelectedRoom = room;
    }

    private bool isRoomClicked()
    {
        if (SelectedRoom != null)
        {
            return true;
        }
        return false;
    }
    private void GoToReservation()
    {
        if (SelectedRoom == null)
            return;

        AppState.SelectedRoom = SelectedRoom;
        AppState.SelectedDate = DateOnly.FromDateTime(SelectedDate);

        Nav.NavigateTo("/reservation");
    }
}
