@page "/Calendar"
@using Microsoft.EntityFrameworkCore
@using RoomsReservation.Data
@using RoomsReservation.Data.Tables
@inject AppDbContext Db

<PageTitle>Kalendarz sal</PageTitle>

<div class="calendar-page">
    <section class="calendar-header-card">
        <div>
            <p class="eyebrow"></p>
            <h1>Kalendarz sal</h1>
        </div>
    </section>

    <section class="calendar-layout">

        <article class="calendar-card">
            <div class="filters-panel">
                <h3>Wyszukiwanie dostępnych sal</h3>

                <div class="filter-grid">
                    <div>
                        <label>Data</label>
                        <input type="date" @bind="filterDate" @bind:format="yyyy-MM-dd" />
                    </div>

                    <div>
                        <label>Od godziny</label>
                        <input type="time" @bind="filterStartTime" @bind:format="HH:mm" />
                    </div>

                    <div>
                        <label>Do godziny</label>
                        <input type="time" @bind="filterEndTime" @bind:format="HH:mm" />
                    </div>

                    <div>
                        <label>Piętro</label>
                        <input type="number" @bind="filterFloor" />
                    </div>

                    <div>
                        <label>Minimalna pojemność</label>
                        <input type="number" @bind="filterCapacity" />
                    </div>

                    <div>
                        <label>Wyposażenie</label>
                        <input type="text" @bind="filterEquipment" placeholder="np. projektor" />
                    </div>
                </div>

                <div class="filter-actions">
                    <button type="button" class="nextPage-btn" @onclick="ApplyFilters">Szukaj</button>
                    <button type="button" class="nextPage-btn" @onclick="ResetFilters">Wyczyść</button>
                </div>
            </div>

            <div class="calendar-toolbar">
                <button type="button" class="nav-btn" aria-label="Poprzedni miesiąc" @onclick="PreviousMonth">←</button>
                <div class="month-label">@MonthTitle</div>
                <button type="button" class="nav-btn" aria-label="Następny miesiąc" @onclick="NextMonth">→</button>
            </div>
            <div class="weekdays">
                @foreach (var dayName in DayNames)
                {
                    <div class="weekday">@dayName</div>
                }
            </div>

            <div class="month-grid">
                @foreach (var cell in CalendarDays)
                {
                    <button type="button"
                            class="day-cell @(cell.IsCurrentMonth ? "" : "muted")  @(selectedDate == cell.Date ? "selected" : "")"
                            @onclick="() => SelectDate(cell.Date)">
                        <div class="day-top">
                            <span class="day-number">@cell.Date.Day</span>
                        </div>

                        <div class="day-body">
                            @if (rooms.Any())
                            {
                                @foreach (var room in filteredRooms)
                                {
                                    if (BusyDateRooms.Contains(room.Id))
                                    {

                                    }
                                    else
                                    {
                                        <div class="mini-event">
                                            <strong>@room.RoomName</strong>
                                            <span>Piętro @room.Floor · @room.Capacity miejsc</span>
                                        </div>
                                    }

                                }
                            }
                        </div>
                    </button>
                }
            </div>
        </article>

        <aside class="details-card">

            <div class="details-header">
                <h2>@selectedDate.ToString("dd.MM.yyyy")</h2>
            </div>

            @if (rooms.Count == 0)
            {
                <div class="empty-state">
                    <p>Brak sal w bazie danych.</p>
                </div>
            }
            else
            {
                <div class="event-list">
                    @foreach (var room in rooms)
                    {
                        <div type="button" class="event-card @(SelectedRoom == room ? "selected" : "")"
                             @onclick="() => SelectRoom(room)">
                            <div class="event-time">
                                <strong>@room.RoomName</strong>
                                <p><span>Piętro @room.Floor</span></p>
                                <div class="btn-to-reservation @(isRoomClicked() && SelectedRoom == room ? "active" : "")">
                                    <button type="button" class="badge bg-success">Zarezerwuj</button>
                                </div>
                            </div>
                            <div class="event-content">
                                <h3>
                                    @if (BusyDateRooms.Contains(room.Id))
                                    {
                                        <span class="badge bg-danger">Zajęta</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Dostępna</span>
                                    }
                                </h3>
                                <p>Pojemność: @room.Capacity</p>
                                <small>@(string.IsNullOrWhiteSpace(room.Professor) ? "Brak przypisanego prowadzącego" : room.Professor)</small>
                                @if (!string.IsNullOrWhiteSpace(room.Description))
                                {
                                    <div class="room-description">@room.Description</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

        </aside>
    </section>
</div>

@code {
    [Parameter][SupplyParameterFromQuery] public int? roomId { get; set; }

    private Room? SelectedRoom;
    private List<Room> rooms = new();
    private List<Room> filteredRooms = new();
    private List<Reservation> reservations = new();
    private List<CalendarDayCell> CalendarDays = new();
    private List<Equipments> EquipmentList = new();
    private List<RoomEquipment> RoomEquipments = new();

    public HashSet<int> BusyDateRooms = new();

    private DateTime currentMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime selectedDate = DateTime.Today;

    private DateTime filterDate = DateTime.Today;
    private DateTime filterStartTime = DateTime.Today.Date.AddHours(8);
    private DateTime filterEndTime = DateTime.Today.Date.AddHours(10);
    private int? filterFloor;
    private int? filterCapacity;

    private string? filterEquipment;
    private static readonly string[] DayNames = ["Pon", "Wt", "Śr", "Czw", "Pt", "Sob", "Nd"];
    private string MonthTitle => currentMonth.ToString("MMMM yyyy", new System.Globalization.CultureInfo("pl-PL"));



    protected override async Task OnParametersSetAsync()
    {
        await LoadDataAsync(roomId);
    }

    private async Task LoadDataAsync(int? roomId)
    {
        await LoadCalendarAsync();

        BuildCalendar();

        if (selectedDate.Month != currentMonth.Month || selectedDate.Year != currentMonth.Year)
            selectedDate = currentMonth;
    }


    private async Task LoadCalendarAsync()
    {

        rooms = await Db.Rooms
            .AsNoTracking()
            .OrderBy(r => r.RoomName)
            .ToListAsync();



        EquipmentList = await Db.Equipments.OrderBy(r => r.EquipmentName).ToListAsync();
        RoomEquipments = await Db.RoomEquipments.ToListAsync();

    }

    private static bool HasTimeOverlap(DateTime start1, DateTime end1, DateTime start2, DateTime end2)
    {
        return start1 < end2 && start2 < end1;
    }

    private async Task ApplyFilters()
    {


        var query = Db.Rooms
            .Include(r => r.RoomEquipments)
                .ThenInclude(re => re.Equipment)
            .AsQueryable();


        if (filterFloor.HasValue)
            query = query.Where(r => r.Floor == filterFloor.Value);


        if (filterCapacity.HasValue)
            query = query.Where(r => r.Capacity >= filterCapacity.Value);


        if (!string.IsNullOrWhiteSpace(filterEquipment))
        {
            string eq = filterEquipment.Trim().ToLower();
            query = query.Where(r =>
                r.RoomEquipments.Any(re =>
                    re.Equipment.EquipmentName.ToLower().Contains(eq)
                )
            );
        }


        var roomsAfterBasicFilters = await query.ToListAsync();


        DateOnly selectedDateOnly = DateOnly.FromDateTime(filterDate);

        var reservationsForDay = await Db.Reservations
            .Include(r => r.Time_Reservation)
            .Where(r => r.DateReservation == selectedDateOnly)
            .ToListAsync();


        var filterStart = filterStartTime.TimeOfDay;
        var filterEnd = filterEndTime.TimeOfDay;

        if (filterEnd <= filterStart)
            filterEnd = filterStart.Add(TimeSpan.FromHours(1));


        BusyDateRooms = reservationsForDay
            .Where(r =>
                r.Time_Reservation.StartTime < filterEnd &&
                filterStart < r.Time_Reservation.EndTime
            )
            .Select(r => r.RoomId)
            .ToHashSet();


        filteredRooms = roomsAfterBasicFilters
            .Where(r => !BusyDateRooms.Contains(r.Id))
            .OrderBy(r => r.RoomName)
            .ToList();

        StateHasChanged();
    }


    private void BuildCalendar()
    {
        CalendarDays.Clear();

        var firstDay = new DateTime(currentMonth.Year, currentMonth.Month, 1);
        var offset = ((int)firstDay.DayOfWeek + 6) % 7;
        var startDate = firstDay.AddDays(-offset);

        for (int i = 0; i < 42; i++)
        {
            var date = startDate.AddDays(i);
            CalendarDays.Add(new CalendarDayCell
            {
                Date = date,
                IsCurrentMonth = date.Month == currentMonth.Month
            });
        }
    }

    private void ResetFilters()
    {
        filterDate = DateTime.Today;
        selectedDate = DateTime.Today;
        filterStartTime = DateTime.Today.Date.AddHours(8);
        filterEndTime = DateTime.Today.Date.AddHours(10);
        filterFloor = null;
        filterCapacity = null;
        filterEquipment = null;

        ApplyFilters();
    }


    private async Task PreviousMonth()
    {
        currentMonth = currentMonth.AddMonths(-1);
        await LoadCalendarAsync();
    }

    private async Task NextMonth()
    {
        currentMonth = currentMonth.AddMonths(1);
        await LoadCalendarAsync();
    }

    private async Task SelectDate(DateTime date)
    {
        selectedDate = date;

        DateOnly SelectedDateOnly = DateOnly.FromDateTime(date);

        BusyDateRooms = await Db.Reservations.Where(r =>
        r.DateReservation == (SelectedDateOnly)
        ).Select(r => r.RoomId).ToHashSetAsync();
    }

    private void SelectRoom(Room room)
    {
        SelectedRoom = room;
    }

    private bool isRoomClicked()
    {
        if (SelectedRoom != null)
        {
            return true;
        }
        return false;
    }
}
